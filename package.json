{
  "name": "e-com",
  "version": "1.0.0",
  "description": "Full-stack e-commerce platform — Next.js frontend + NestJS backend",
  "private": true,
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run start:dev",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "start:frontend": "cd frontend && npm start",
    "start:backend": "cd backend && npm run start:prod",
    "test:backend": "cd backend && npm run test",
    "test:backend:e2e": "cd backend && npm run test:e2e"
  },
  "keywords": ["ecommerce", "nextjs", "nestjs", "typescript"],
  "license": "MIT"
}
